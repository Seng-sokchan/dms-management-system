# Server
PORT=4000
NODE_ENV=production

# Caddy (Let's Encrypt contact for api.dmscambodia.com)
ACME_EMAIL=admin@dmscambodia.com

# Auth (required)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=365d

# MariaDB (Docker service `mariadb`)
DB_HOST=mariadb
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=fix_asset_db

# Redis (recommended for payments / live checkout state)
REDIS_URL=redis://host.docker.internal:6379

# Payment checkout session TTL in minutes (default 5)
PAYMENT_CHECKOUT_TTL_MINUTES=5

# CORS + Socket.IO origins
FRONTEND_URL=https://your-frontend-domain.com
MOBILE_URL=https://your-mobile-domain.com

# PayWay (payments) — use https://api.dmscambodia.com for return_url in production
# PAYWAY_CALLBACK_URL is Base64-encoded and sent as return_url on purchase (not callback_url)
PAYWAY_API_KEY=
PAYWAY_MERCHANT_ID=
PAYWAY_CALLBACK_URL=https://api.dmscambodia.com/v1/webhooks/payway
PAYWAY_PURCHASE_URL=
# V2 check-transaction endpoint (sandbox default used if empty)
PAYWAY_CHECK_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/check-transaction-2
PAYWAY_RETURN_DEEPLINK_BASE=dms://payment/result/success
PAYWAY_RETURN_DEEPLINK_MODE=base64
PAYWAY_REFERER=

# Rate limits (optional)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100
PAYWAY_WEBHOOK_RATE_LIMIT_MAX=100

# Telegram alerts (optional) — factory submit + delivered confirm
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
