{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-var": "error",
    "prefer-const": "error",
    "prefer-arrow-callback": "warn",
    "eqeqeq": ["error", "smart"],
    "curly": ["error", "multi-line"],
    "no-param-reassign": ["error", { "props": false }],
    "no-throw-literal": "error",
    "consistent-return": "warn",
    "require-await": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.test.js"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/server.js", "src/utils/logger.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/", "logs/", "db/", "*.sql"]
}
