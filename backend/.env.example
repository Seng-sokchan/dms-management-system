# ABA PayWay (sandbox defaults)
PAYWAY_MERCHANT_ID=your_merchant_id
PAYWAY_API_KEY=your_api_key
PAYWAY_CALLBACK_URL=https://api.example.com/v1/webhooks/payway
# Opened by ABA Mobile after pay — must match mobile app URL scheme (dms://payment/result/success)
PAYWAY_RETURN_DEEPLINK_BASE=dms://payment/result/success
# PayWay API field: base64({"android_scheme","ios_scheme"}) or plain (PAYWAY_RETURN_DEEPLINK_MODE=plain)
PAYWAY_RETURN_DEEPLINK_MODE=base64
PAYWAY_PURCHASE_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
PAYWAY_CHECK_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/check-transaction
