{
  "name": "MobileApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "node -r ./scripts/polyfill-util-styletext.cjs ./node_modules/react-native/cli.js run-android --active-arch-only",
    "android:release": "cd android && gradlew.bat assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "android:install-release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "website:apk": "node scripts/copy-apk-to-website.cjs",
    "icons": "node scripts/generate-icons.cjs",
    "ios": "node -r ./scripts/polyfill-util-styletext.cjs ./node_modules/react-native/cli.js run-ios",
    "lint": "eslint .",
    "start": "node -r ./scripts/polyfill-util-styletext.cjs ./node_modules/react-native/cli.js start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native/new-app-screen": "0.85.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "axios": "^1.16.0",
    "i18next": "^26.2.0",
    "react": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-background-actions": "^4.1.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-maps": "^1.27.2",
    "react-native-maps-directions": "^1.9.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.4",
    "react-native-vector-icons": "^10.2.0",
    "react-native-webview": "^13.16.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
